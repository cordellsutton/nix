[global_config]
  ask_before_closing = never
  smart_copy = False
  cell_width = 0.1
[keybindings]
  go_up = <Primary>k
  go_down = <Primary>j
  go_left = <Primary>h
  go_right = <Primary>l
  resize_up = <Primary><Shift>k
  resize_down = <Primary><Shift>j
  resize_left = <Primary><Shift>h
  resize_right = <Primary><Shift>l
  group_all = <Primary>g
  preferences_keybindings = <Primary>asciitilde
[profiles]
  [[default]]
    background_color = "#deddda"
    background_darkness = 0.9
    cursor_fg_color = "#000000"
    cursor_bg_color = "#c0bfbc"
    cursor_color_default = False
    font = Hack 8
    foreground_color = "#000000"
    use_system_font = False
    copy_on_selection = True
    title_hide_sizetext = True
    title_use_system_font = False
    title_font = CodingFontTobi 9
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
